    "historical_reconstruction_allowed": false
  },
  "transformations": [
    {
      "transformation_id": "raw",
      "transformation_version": "v1",
      "allowed_semantic_types": [
        "CONTINUOUS",
        "BOOLEAN",
        "CATEGORICAL"
      ],
      "required_parameters": [],
      "history_requirement": "NONE",
      "semantics": "Use the recorded point-in-time feature value without transformation."
    },
    {
      "transformation_id": "delta_observations",
      "transformation_version": "v1",
      "allowed_semantic_types": [
        "CONTINUOUS"
      ],
      "required_parameters": [
        "lag_observations"
      ],
      "allowed_lag_observations": [
        1,
        5,
        10
      ],
      "history_requirement": "LAG_OBSERVATIONS",
      "semantics": "Current recorded value minus the value from the predeclared prior scanner-observation lag."
    },
    {
      "transformation_id": "change_direction",
      "transformation_version": "v1",
      "allowed_semantic_types": [
        "CONTINUOUS"
      ],
      "required_parameters": [
        "lag_observations"
      ],
      "allowed_lag_observations": [
        1,
        5,
        10
      ],
      "history_requirement": "LAG_OBSERVATIONS",
      "semantics": "Direction of the point-in-time change over the predeclared scanner-observation lag; no magnitude threshold is tuned post hoc."
    },
    {
      "transformation_id": "threshold_crossing",
      "transformation_version": "v1",
      "allowed_semantic_types": [
        "CONTINUOUS"
      ],
      "required_parameters": [
        "threshold"
      ],
      "history_requirement": "ONE_PRIOR_OBSERVATION",
      "semantics": "Crossing of an explicitly feature-registered threshold between the prior and current point-in-time observation."
    },
    {
      "transformation_id": "state_transition",
      "transformation_version": "v1",
      "allowed_semantic_types": [
        "BOOLEAN",
        "CATEGORICAL"
      ],
      "required_parameters": [],
      "history_requirement": "ONE_PRIOR_OBSERVATION",
      "semantics": "Recorded point-in-time change from the prior categorical or boolean state to the current state."
    },
    {
      "transformation_id": "regime_context",
      "transformation_version": "v1",
      "allowed_semantic_types": [
        "CATEGORICAL"
      ],
      "required_parameters": [],
      "history_requirement": "NONE",
      "semantics": "Use a registered market-regime state only as contemporaneous point-in-time context."
    },
    {
      "transformation_id": "level_band",
      "transformation_version": "v1",
      "allowed_semantic_types": [
        "CONTINUOUS"
      ],
      "required_parameters": [],
      "history_requirement": "NONE",
      "semantics": "Predeclared 0<=cycle<25;25<=cycle<50;50<=cycle<75;75<=cycle<=100. Requires released CY-03 current observation."
    }
  ],
