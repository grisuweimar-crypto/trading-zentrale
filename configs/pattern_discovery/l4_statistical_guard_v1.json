{
  "schema_version": "pattern_discovery_l4_statistical_guard_v1",
  "module": "pattern_discovery_lab",
  "phase": "L4",
  "name": "Statistical Discovery Guard",
  "status": "active_research_contract",
  "research_only": true,
  "productive_integration_enabled": false,
  "execution_allowed": false,
  "purpose": "Convert raw L3 Discovery candidates into guarded Discovery Evidence while controlling multiplicity, temporal dependence, concentration, baseline lift and robust uncertainty.",
  "principles": {
    "all_tested_candidates_enter_multiple_testing_family": true,
    "l3_rejections_remain_visible": true,
    "raw_hit_rate_never_sufficient": true,
    "raw_n_is_not_effective_n": true,
    "discovery_and_confirmation_are_strictly_separate": true,
    "insufficient_evidence_fails_closed": true,
    "negative_results_are_retained": true,
    "candidate_freeze_is_not_performed_here": true,
    "productive_semantics_must_not_change": true
  },
  "bindings": {
    "l1_frozen_run_manifest_required": true,
    "l2_feature_library_exact_binding_required": true,
    "l3_result_hash_required": true,
    "l3_replay_identity_required": true
  },
  "supported_statistical_primary_methods": [
    "cluster_aware_effect_and_probability_estimation"
  ],
  "implemented_robustness_checks": [
    "moving_block_bootstrap",
    "symbol_concentration",
    "temporal_support"
  ],
  "multiple_testing": {
    "supported_primary_methods": [
      "BONFERRONI_FWER",
      "HOLM_FWER",
      "BENJAMINI_HOCHBERG_FDR"
    ],
    "single_primary_supported": false,
    "single_primary_reason": "L1 v1 does not preregister a family alpha for PREDECLARED_SINGLE_PRIMARY, so L4 v1 fails closed rather than inventing one after search.",
    "custom_predeclared_supported": false,
    "family_scope": "L3_FAMILY_ALL_TESTED_CANDIDATES",
    "raw_p_value_method": "DEPENDENCY_AWARE_ONE_SIDED_NORMAL_APPROXIMATION",
    "missing_or_uncomputable_p_value": 1.0
  },
  "dependence": {
    "block_length_sessions_multiplier": 2,
    "support_region_method": "GREEDY_NONOVERLAPPING_OCCURRENCE_REGIONS_ON_BASELINE_DATE_AXIS",
    "effective_n_method": "UNIQUE_SYMBOL_X_SUPPORT_REGION_CLUSTER_COUNT",
    "bootstrap_method": "DETERMINISTIC_HASH_SEEDED_CIRCULAR_MOVING_BLOCK_BOOTSTRAP",
    "bootstrap_repetitions": 512,
    "bootstrap_interval": [0.025, 0.975]
  },
  "concentration_gates": {
    "minimum_symbol_count": 2,
    "maximum_top_symbol_share": 0.5,
    "maximum_top_observation_date_share": 0.5,
    "maximum_top_support_region_share": 0.75
  },
  "coverage_gates": {
    "minimum_mature_target_coverage": 0.8
  },
  "robustness_gates": {
    "aligned_effect_interval_must_exclude_zero": true,
    "probability_lift_interval_must_exclude_zero": true
  },
  "diagnostic_split_fields": [
    "sector",
    "pillar_primary",
    "cluster_official",
    "market_regime_stock",
    "market_regime_crypto"
  ],
  "identity": {
    "hash_algorithm": "sha256",
    "canonical_json": true,
    "evidence_schema_version": "pattern_discovery_l4_evidence_v1",
    "evidence_path_template": "artifacts/research/pattern_discovery/discovery_runs/{run_id}/l4_discovery_evidence.json"
  },
  "boundaries": {
    "l5_candidate_freeze_performed": false,
    "qm_c_registration_performed": false,
    "prospective_confirmation_performed": false,
    "rating_assigned": false,
    "promotion_performed": false,
    "productive_scanner_or_decision_semantics_changed": false
  }
}
