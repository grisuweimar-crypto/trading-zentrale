{
  "schema_version": "pattern_discovery_l9_confirmation_engine_v1",
  "module": "pattern_discovery_lab",
  "phase": "L9",
  "name": "Confirmation & Falsification Engine",
  "status": "active_research_contract",
  "research_only": true,
  "productive_integration_enabled": false,
  "execution_allowed": false,
  "purpose": "Evaluate immutable frozen Pattern versions using only strictly post-freeze matured L8 outcomes, exact QM-C governance, predeclared sequential looks and multiplicity control, while persisting positive, negative and unresolved evidence without assigning ratings or promotion.",
  "principles": {
    "discovery_evidence_never_counts_as_confirmation": true,
    "only_hash_valid_l8_matured_outcomes_are_confirmation_events": true,
    "strictly_post_freeze_outcomes_only": true,
    "pattern_versions_and_horizons_remain_separate": true,
    "frozen_target_direction_baseline_and_horizon_are_immutable": true,
    "qm_c1_c2_c3_c4_are_authoritative": true,
    "l9_does_not_create_competing_qm_governance": true,
    "unplanned_or_out_of_order_looks_fail_closed": true,
    "sequential_multiplicity_is_predeclared": true,
    "missing_maturity_is_unresolved_not_falsified": true,
    "missing_baseline_is_unresolved_not_falsified": true,
    "no_posthoc_subgroup_rescue": true,
    "diagnostic_splits_never_replace_primary_full_sample_evidence": true,
    "raw_n_is_not_effective_n": true,
    "negative_results_are_retained": true,
    "confirmation_does_not_assign_rating": true,
    "confirmation_does_not_promote": true,
    "productive_semantics_must_not_change": true
  },
  "bindings": {
    "l5_frozen_pattern_schema": "pattern_discovery_l5_frozen_pattern_v1",
    "l8_matured_outcome_schema": "pattern_discovery_l8_matured_outcome_v1",
    "qm_c1_contract_schema": "qm_c_hypothesis_registry_v1",
    "qm_c2_contract_schema": "qm_c_analysis_plan_v1",
    "qm_c3_contract_schema": "qm_c3_families_multiplicity_v1",
    "qm_c4_contract_schema": "qm_c4_sequential_monitoring_v1",
    "qm_c5_contract_schema": "qm_c5_negative_results_v1",
    "qm_a_contract_schema": "qm_a_research_governance_v1",
    "exact_l5_qm_handoff_must_be_applied": true,
    "exact_qm_c3_family_membership_required": true,
    "exact_qm_c4_monitoring_plan_required": true,
    "direct_qm_registry_write_forbidden_by_l0": true,
    "qm_c4_c5_handoff_required": true
  },
  "baseline_bundle": {
    "schema_version": "pattern_discovery_l9_baseline_bundle_v1",
    "hash_algorithm": "sha256",
    "required_fields": [
      "baseline_bundle_id",
      "generated_at",
      "pattern_baselines"
    ],
    "pattern_baseline_required_fields": [
      "pattern_id",
      "pattern_version",
      "pattern_spec_hash",
      "baseline_definition",
      "target_id",
      "horizon_sessions",
      "observations"
    ],
    "observation_required_fields": [
      "baseline_event_id",
      "symbol",
      "start_at",
      "end_at",
      "target_value",
      "target_id",
      "horizon_sessions",
      "source_hash"
    ],
    "strictly_post_freeze_required": true,
    "target_and_horizon_must_match_pattern": true,
    "baseline_definition_must_match_frozen_pattern": true
  },
  "context_bundle": {
    "schema_version": "pattern_discovery_l9_context_bundle_v1",
    "hash_algorithm": "sha256",
    "required_fields": [
      "context_bundle_id",
      "generated_at",
      "claim_contexts"
    ],
    "claim_context_required_fields": [
      "claim_id",
      "symbol",
      "observation_as_of",
      "context_source_hash"
    ],
    "allowed_optional_fields": [
      "sector",
      "segment",
      "pillar_primary",
      "cluster_official",
      "market_regime_stock",
      "market_regime_crypto"
    ],
    "observation_as_of_must_not_follow_claim_capture": true
  },
  "statistics": {
    "primary_method": "PROSPECTIVE_CLUSTER_AWARE_CONFIRMATION_V1",
    "alignment": "EXPECTED_DIRECTION_SIGN",
    "probability_definition": "SHARE_OF_ALIGNED_TARGET_VALUES_GREATER_THAN_ZERO",
    "baseline_probability_definition": "SHARE_OF_ALIGNED_BASELINE_TARGET_VALUES_GREATER_THAN_ZERO",
    "probability_lift_definition": "DIRECTION_PROBABILITY_MINUS_BASELINE_PROBABILITY",
    "effect_size_definition": "MEAN_ALIGNED_TARGET_MINUS_MEAN_ALIGNED_BASELINE",
    "effective_n_method": "UNIQUE_SYMBOL_X_SUPPORT_REGION_CLUSTER_COUNT",
    "support_region_method": "GREEDY_NONOVERLAPPING_OCCURRENCE_REGIONS_ON_COMBINED_PROSPECTIVE_DATE_AXIS",
    "block_length_sessions_multiplier": 2,
    "bootstrap_method": "DETERMINISTIC_HASH_SEEDED_CIRCULAR_MOVING_BLOCK_BOOTSTRAP",
    "bootstrap_repetitions": 512,
    "bootstrap_interval": [
      0.025,
      0.975
    ],
    "raw_p_value_method": "DEPENDENCY_AWARE_ONE_SIDED_NORMAL_APPROXIMATION",
    "single_primary_alpha": 0.05,
    "sequential_alpha_method": "BONFERRONI_OVER_PREDECLARED_QM_C4_LOOK_COUNT"
  },
  "look_readiness": {
    "information_denominator_source": "FROZEN_PATTERN_SPEC_MINIMUM_RAW_N",
    "required_candidate_raw_n": "CEIL(MINIMUM_RAW_N_X_INFORMATION_FRACTION)",
    "required_baseline_raw_n": "CEIL(MINIMUM_RAW_N_X_INFORMATION_FRACTION)",
    "all_qm_c3_family_members_must_be_ready_for_family_look": true,
    "not_ready_status": "UNRESOLVED_NOT_DUE",
    "not_ready_consumes_qm_c4_look": false
  },
  "confirmation_gates": {
    "minimum_effect_size_source": "FROZEN_PATTERN_SPEC_MINIMUM_EFFECT_SIZE",
    "minimum_probability_lift_source": "FROZEN_PATTERN_SPEC_MINIMUM_BASELINE_LIFT",
    "minimum_support_regions_source": "FROZEN_PATTERN_SPEC_MINIMUM_TEMPORAL_SUPPORT_REGIONS",
    "minimum_symbol_count": 2,
    "maximum_top_symbol_share": 0.5,
    "maximum_top_observation_date_share": 0.5,
    "maximum_top_support_region_share": 0.75,
    "effect_interval_lower_must_exceed_zero": true,
    "probability_lift_interval_lower_must_exceed_zero": true,
    "sequentially_adjusted_multiple_testing_must_pass": true,
    "context_coverage_minimum_for_confirmation": 0.8,
    "minimum_split_n_for_stability_diagnostic": 3,
    "temporal_half_sign_reversal_blocks_confirmation": true,
    "regime_sign_reversal_blocks_confirmation": true
  },
  "falsification": {
    "strong_falsification_requires_final_or_predeclared_futility_look": true,
    "effect_interval_upper_at_or_below_zero": true,
    "probability_lift_interval_upper_at_or_below_zero": true,
    "both_robust_falsification_conditions_required": true,
    "simple_gate_failure_is_not_automatic_falsification": true,
    "final_nonconfirmed_without_strong_reversal_classification": "NEGATIVE_NOT_CONFIRMED",
    "missing_or_insufficient_evidence_classification": "INCONCLUSIVE"
  },
  "multiplicity": {
    "supported_strategies": [
      "PREDECLARED_SINGLE_PRIMARY",
      "BONFERRONI_FWER",
      "HOLM_FWER",
      "BENJAMINI_HOCHBERG_FDR"
    ],
    "custom_predeclared_fails_closed": true
  },
  "sequential_decisions": {
    "interim_default": "CONTINUE",
    "interim_positive_if_early_stop_allowed": "STOP_EFFICACY",
    "interim_falsified_if_early_stop_allowed": "STOP_FUTILITY",
    "final_required": "FINAL_COMPLETE"
  },
  "result_classes": [
    "SUPPORTED",
    "FALSIFIED",
    "NEGATIVE_NOT_CONFIRMED",
    "INCONCLUSIVE",
    "UNRESOLVED_NOT_DUE"
  ],
  "qm_c5_mapping": {
    "SUPPORTED": "POSITIVE",
    "FALSIFIED": "NEGATIVE",
    "NEGATIVE_NOT_CONFIRMED": "NEGATIVE",
    "INCONCLUSIVE": "INCONCLUSIVE",
    "UNRESOLVED_NOT_DUE": null
  },
  "storage": {
    "look_schema_version": "pattern_discovery_l9_confirmation_look_v1",
    "look_registry_event_schema_version": "pattern_discovery_l9_confirmation_registry_event_v1",
    "look_registry_path": "artifacts/research/pattern_discovery/confirmation_looks.jsonl",
    "look_report_path_template": "artifacts/research/pattern_discovery/confirmation_reports/{monitoring_plan_id}/{look_id}/{look_hash}.json",
    "registry_is_append_only": true,
    "registry_is_hash_chained": true,
    "one_local_artifact_per_qm_c4_look": true,
    "identical_replay_is_idempotent": true,
    "look_identity_collision_fails_closed": true
  },
  "boundaries": {
    "l8_outcome_mutation_performed": false,
    "qm_c_registry_write_performed": false,
    "rating_assigned": false,
    "promotion_performed": false,
    "decision_layer_integration_performed": false,
    "portfolio_or_execution_effect_created": false
  }
}
