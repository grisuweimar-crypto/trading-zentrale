  "aggregation": {
    "tradable_if_any_venue_latest_status_tradable": true,
    "suspended_if_no_tradable_and_any_venue_suspended": true,
    "not_tradable_if_at_least_one_venue_observed_and_all_latest_venue_states_not_tradable": true,
    "unknown_if_no_pit_venue_evidence": true,
    "same_venue_latest_conflict": "UNKNOWN"
  },
  "pit_rules": {
    "historical_retrojection_permitted": false,
    "future_evidence_usable_for_past_as_of": false,
    "valid_to_semantics": "closed_open_[valid_from,valid_to)",
    "absence_of_event_is_positive_evidence": false
