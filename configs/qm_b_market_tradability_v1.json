{
  "schema_version": "qm_b_market_tradability_v1",
  "module": "QM-B",
  "name": "Market Tradability Evidence Contract",
  "status": "research_validation",
  "research_only": true,
  "productive_integration_enabled": false,
  "principles": [
    "market tradability is venue-specific and separate from listing state, project membership and execution-channel availability",
    "TRADABLE requires explicit instrument-level PIT evidence from at least one registered venue/source",
    "absence of a halt or suspension record is not positive tradability evidence",
    "price availability, non-zero volume, scanner presence, successful provider quotes and symbol suffixes are not market-tradability evidence",
    "listing alone does not prove current tradability",
    "SUSPENDED and NOT_TRADABLE must be representable without converting missing coverage into a negative claim",
    "source evidence is never back-projected",
    "same-venue conflicting latest evidence fails closed to UNKNOWN"
  ],
  "status_values": ["TRADABLE", "SUSPENDED", "NOT_TRADABLE", "UNKNOWN"],
  "required_evidence_fields": [
    "instrument_id",
    "venue_id",
    "status",
    "valid_from",
    "pit_verified",
    "source_id"
  ],
  "registered_sources": [],
