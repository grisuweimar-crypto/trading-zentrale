{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elliott vNext module output",
  "type": "object",
  "required": [
    "symbol", "as_of", "timeframe", "degree", "primary_scenario",
    "alternative_scenarios", "pivots", "fibonacci", "hard_invalidations",
    "structural_fit", "confirmation_strength", "historical_expectancy",
    "routing_triggers", "warnings"
  ],
  "properties": {
    "symbol": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "timeframe": {"enum": ["daily", "weekly"]},
    "degree": {"type": "string"},
    "primary_scenario": {"type": "object"},
    "alternative_scenarios": {"type": "array", "items": {"type": "object"}},
    "pivots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pivot_time", "confirmed_time", "price", "kind"],
        "properties": {
          "pivot_time": {"type": "string", "format": "date"},
          "confirmed_time": {"type": "string", "format": "date"},
          "price": {"type": "number"},
          "kind": {"enum": ["high", "low"]}
        }
      }
    },
    "fibonacci": {
      "type": "object",
      "required": ["anchor_start", "anchor_end", "zones"],
      "properties": {
        "anchor_start": {"type": "object"},
        "anchor_end": {"type": "object"},
        "zones": {"type": "array", "items": {"type": "object"}}
      }
    },
    "hard_invalidations": {"type": "array", "items": {"type": "object"}},
    "rule_violations": {"type": "array", "items": {"type": "string"}},
    "structural_fit": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confirmation_strength": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "historical_expectancy": {"type": ["object", "null"]},
    "market_context": {"type": ["object", "null"]},
    "relative_strength": {"type": ["object", "null"]},
    "routing_triggers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "trade_decision": {"not": {}}
  },
  "additionalProperties": true
}