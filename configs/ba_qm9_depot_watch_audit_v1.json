{
  "schema_version": "ba_qm9_depot_watch_audit_v1",
  "business_area": "BA-QM9",
  "name": "Wertpapierdepot-Watch Audit",
  "status": "IN_PROGRESS_PARALLEL_PREPARATION",
  "research_only": true,
  "productive_integration_enabled": false,
  "execution_allowed": false,
  "empirical_promotion_performed": false,
  "input_path": [
    "RESEARCH_SNAPSHOT",
    "DECISION_BUNDLE",
    "DEPOT_SNAPSHOT",
    "WERTPAPIERDEPOT_WATCH"
  ],
  "required_checks": [
    "IDENTITY",
    "TIME",
    "COMPLETENESS",
    "POSITION_STATE",
    "ADD_CAPACITY",
    "ACTION_SEMANTICS",
    "MISSING_EVIDENCE",
    "STALE_DATA",
    "FAIL_CLOSED",
    "EXPLANATION",
    "REPRODUCIBILITY"
  ],
  "authoritative_contracts": {
    "research_snapshot": "artifacts/research/daily_research.json",
    "decision_snapshot": "artifacts/research/decision_snapshot_w10.json",
    "decision_bundle_builder": "src/scanner/research/decision_layer/depot_watch_orchestrator.py",
    "watch_contract": "src/scanner/research/decision_layer/depot_watch.py",
    "position_action_contract": "src/scanner/research/decision_layer/portfolio_action.py",
    "explanation_contract": "src/scanner/research/decision_layer/reliability_explainability.py",
    "runtime_transport": "src/scanner/research/decision_layer/watch_runtime.py",
    "private_runner": "scripts/run_depot_watch_orchestrated.py"
  },
  "check_contract": {
    "IDENTITY": {
      "research_snapshot_id_required": true,
      "decision_bundle_same_snapshot_required": true,
      "exact_symbol_identity_required": true,
      "fuzzy_symbol_matching_forbidden": true,
      "position_context_identity_must_match_7f": true
    },
    "TIME": {
      "position_may_not_be_future_to_decision": true,
      "decision_bundle_as_of_must_match_authoritative_watch_as_of": true,
      "later_evidence_backdating_forbidden": true
    },
    "COMPLETENESS": {
      "one_watch_row_per_position_required": true,
      "duplicate_position_symbols_forbidden": true,
      "watch_status_must_match_available_row_counts": true,
      "missing_bundle_must_remain_visible": true
    },
    "POSITION_STATE": {
      "position_state_must_come_from_supplied_depot_snapshot": true,
      "model_portfolio_substitution_forbidden": true,
      "legacy_holdings_substitution_forbidden": true,
      "position_state_may_not_rewrite_universal_stance": true
    },
    "ADD_CAPACITY": {
      "capacity_must_derive_only_from_can_add_or_remaining_adds": true,
      "contradictory_capacity_fails_closed": true,
      "unknown_capacity_must_remain_unknown": true,
      "changed_capacity_invalidates_old_7f_context": true
    },
    "ACTION_SEMANTICS": {
      "watch_may_present_but_not_recompute_action": true,
      "review_states_are_not_orders": true,
      "execution_allowed": false,
      "position_sizing_forbidden": true,
      "target_weight_forbidden": true
    },
    "MISSING_EVIDENCE": {
      "missing_decision_bundle_produces_unavailable_row": true,
      "unavailable_row_decision_must_be_null": true,
      "scanner_scalar_fallback_forbidden": true,
      "missing_evidence_may_not_be_neutralized": true
    },
    "STALE_DATA": {
      "decision_snapshot_mismatch_is_stale_and_blocked": true,
      "decision_as_of_mismatch_is_stale_and_blocked": true,
      "future_position_snapshot_is_blocked": true,
      "depot_wall_clock_freshness_threshold_defined": false,
      "undefined_depot_age_may_not_be_claimed_fresh": true
    },
    "FAIL_CLOSED": {
      "invalid_bundle_isolated_per_symbol": true,
      "ambiguous_duplicate_positions_fail_hard": true,
      "position_context_mismatch_produces_unavailable": true,
      "forbidden_execution_fields_fail_hard": true
    },
    "EXPLANATION": {
      "decision_explanation_id_required_for_available_rows": true,
      "reliability_is_not_success_probability": true,
      "missing_or_limited_evidence_remains_visible": true,
      "change_triggers_must_require_upstream_recompute": true
    },
    "REPRODUCIBILITY": {
      "watch_id_canonical_hash_required": true,
      "post_build_tampering_detected": true,
      "sealed_w10_identity_required_in_private_orchestration": true,
      "compact_runtime_must_preserve_decision_semantics": true
    }
  },
  "forbidden_shortcuts": [
    "replace_missing_decision_state_with_scanner_score",
    "replace_missing_decision_state_with_r_code",
    "replace_missing_decision_state_with_old_scanner_heuristic",
    "fuzzy_match_position_symbol",
    "infer_add_capacity_from_market_signal",
    "treat_unknown_add_capacity_as_available",
    "turn_review_state_into_broker_order",
    "persist_private_position_book_to_public_repository",
    "claim_undefined_depot_age_is_fresh"
  ],
  "ba_qm8_dependency": {
    "parallel_engineering_preparation_allowed": true,
    "ba_qm9_engineering_closure_requires_ba_qm8_engineering_closure": true,
    "ba_qm8_current_expected_status": "PENDING_PROSPECTIVE_SNAPSHOT"
  },
  "governance_guard": {
    "lag1_finding_id": "QM-H-QMJ-PHASE1A-LAG1-001",
    "lag1_capa_id": "QM-H-CAPA-QMJ-PHASE1A-LAG1-001",
    "evidence_impact": "PROMOTION_BLOCKED",
    "ba_qm9_may_release_promotion_block": false,
    "automatic_release_allowed": false
  },
  "closure_claimed": false,
  "next_step": "Validate this BA-QM9 contract against existing 7H/W8/W11/W12 behavior, add explicit stale-state handling without inventing a wall-clock threshold, then build a real/synthetic end-application audit before BA-QM9 closure."
}
