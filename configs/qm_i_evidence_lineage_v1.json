{
  "schema_version": "qm_i_evidence_lineage_v1",
  "module": "QM-I",
  "business_area": "BA-QM3",
  "name": "Evidence Lineage & Double Counting",
  "status": "active_research_governance",
  "research_only": true,
  "productive_integration_enabled": false,
  "execution_allowed": false,
  "purpose": "Represent material evidence provenance as a typed immutable graph, preserve stable upstream identities, test independence claims against known ancestry, and trigger review when combined evidence has common, direct, or incompletely known ancestry.",
  "principles": {
    "stable_upstream_ids_must_be_reused": true,
    "mutable_labels_may_not_replace_stable_ids": true,
    "missing_lineage_is_not_independence": true,
    "common_ancestry_is_review_trigger_not_automatic_defect": true,
    "direct_reference_is_not_independent_confirmation": true,
    "absence_of_known_common_ancestor_does_not_prove_independence_when_lineage_incomplete": true,
    "independence_supported_requires_complete_lineage_and_review_reference": true,
    "lineage_does_not_change_scanner_or_decision_semantics": true,
    "qm_a_evidence_state_remains_authoritative": true,
    "qm_b_pit_constraints_remain_authoritative": true,
    "qm_c_identity_chain_remains_authoritative": true,
    "qm_h_capa_authority_preserved": true
  },
  "registry": {
    "event_schema_version": "qm_i_lineage_event_v1",
    "hash_algorithm": "sha256",
    "hash_chain_required": true,
    "default_path": "artifacts/research/qm/qm_i_lineage_events.jsonl",
    "event_types": [
      "NODE_REGISTERED",
      "EDGE_REGISTERED",
      "INDEPENDENCE_CLAIM_REGISTERED"
    ]
  },
  "node": {
    "required_fields": [
      "node_id",
      "version_id",
      "node_type",
      "content_hash",
      "lineage_complete",
      "as_of",
      "metadata"
    ],
    "node_types": [
      "RAW_SOURCE",
      "FEATURE",
      "INDICATOR",
      "SCORE",
      "DERIVED_METRIC",
      "CLAIM",
      "CALIBRATION",
      "HYPOTHESIS",
      "ANALYSIS_PLAN",
      "CONTROL_PLAN",
      "MONITORING_PLAN",
      "RESULT",
      "EXTERNAL_EVIDENCE",
      "DECISION_CONTEXT",
      "DECISION",
      "PORTFOLIO_ACTION",
      "POSITION_SNAPSHOT",
      "WATCH"
    ],
    "root_node_types": ["RAW_SOURCE", "EXTERNAL_EVIDENCE", "POSITION_SNAPSHOT"],
    "semantic_id_fields": {
      "CLAIM": "claim_id",
      "CALIBRATION": "calibration_id",
      "HYPOTHESIS": "hypothesis_id",
      "ANALYSIS_PLAN": "analysis_plan_id",
      "CONTROL_PLAN": "control_plan_id",
      "MONITORING_PLAN": "monitoring_plan_id",
      "RESULT": "result_id",
      "DECISION": "decision_id",
      "WATCH": "watch_id"
    }
  },
  "edge": {
    "required_fields": [
      "edge_id",
      "from_node_id",
      "from_version_id",
      "to_node_id",
      "to_version_id",
      "relation",
      "material_for_ancestry"
    ],
    "relations": [
      "DERIVED_FROM",
      "REFERENCES",
      "ANNOTATES",
      "CALIBRATES",
      "INFORMS",
      "PRODUCES",
      "USES_POSITION",
      "PRESENTS",
      "ASSOCIATED_WITH"
    ],
    "ancestry_relations": [
      "DERIVED_FROM",
      "REFERENCES",
      "ANNOTATES",
      "CALIBRATES",
      "INFORMS",
      "PRODUCES",
      "USES_POSITION",
      "PRESENTS"
    ],
    "acyclic_ancestry_required": true
  },
  "independence_claim": {
    "required_fields": [
      "independence_claim_id",
      "version_id",
      "left_node_id",
      "left_version_id",
      "right_node_id",
      "right_version_id",
      "status",
      "review_reference",
      "rationale"
    ],
    "statuses": [
      "INDEPENDENT_SUPPORTED",
      "DEPENDENT_COMMON_ANCESTRY",
      "DEPENDENT_DIRECT_REFERENCE",
      "UNKNOWN_REVIEW_REQUIRED",
      "NOT_APPLICABLE"
    ],
    "independent_supported_requires_nonempty_review_reference": true,
    "same_node_cannot_be_independent": true
  },
  "ancestry_analysis": {
    "classifications": [
      "SAME_EVIDENCE",
      "DIRECT_DEPENDENCY",
      "COMMON_ANCESTRY",
      "UNKNOWN_INCOMPLETE_LINEAGE",
      "NO_COMMON_ANCESTRY_DETECTED"
    ],
    "rootless_complete_nonroot_is_invalid_for_independence": true,
    "common_ancestor_paths_required": true
  },
  "double_counting_review": {
    "trigger_states": [
      "DIRECT_DEPENDENCY_REVIEW_REQUIRED",
      "COMMON_ANCESTRY_REVIEW_REQUIRED",
      "INCOMPLETE_LINEAGE_REVIEW_REQUIRED",
      "INDEPENDENCE_CLAIM_MISSING_REVIEW_REQUIRED",
      "INDEPENDENCE_CLAIM_CONTRADICTION_REVIEW_REQUIRED"
    ],
    "no_trigger_state": "NO_DOUBLE_COUNTING_TRIGGER",
    "common_ancestry_is_automatic_error": false,
    "automatic_weight_change_allowed": false,
    "automatic_scanner_or_decision_change_allowed": false
  },
  "phase7_integration": {
    "input_contract_schema": "decision_layer_input_contract_v1",
    "reuse_claim_id": true,
    "reuse_source_snapshot_id": true,
    "claim_ref_becomes_references_edge": true,
    "probability_and_confidence_do_not_become_independent_votes": true,
    "same_family_timing_independence_not_inferred": true,
    "universal_stance_schema": "decision_universal_stance_v1",
    "portfolio_action_schema": "decision_portfolio_action_v1",
    "w8_state_history_claim_is_material_action_parent": true,
    "w8_changed_action_requires_registered_state_history": true,
    "w6_elliott_context_is_material_action_parent": true,
    "w6_context_lineage_incomplete_until_upstream_elliott_binding": true,
    "depot_watch_schema": "decision_depot_watch_v1",
    "watch_id_reused_from_phase7h": true,
    "decision_id_must_be_supplied_when_source_artifact_has_no_stable_decision_id": true,
    "historical_decision_ids_may_not_be_guessed": true
  },
  "qm_c_integration": {
    "handoff_schema": "ba_qm2_handoff_v2",
    "reuse_hypothesis_identity": true,
    "reuse_analysis_plan_identity": true,
    "reuse_control_plan_identity": true,
    "reuse_monitoring_plan_identity": true,
    "reuse_result_identity": true
  },
  "required_lineage_path_types": [
    "RAW_SOURCE",
    "FEATURE",
    "INDICATOR",
    "SCORE",
    "CLAIM",
    "CALIBRATION",
    "DECISION",
    "WATCH"
  ],
  "boundaries": {
    "independence_inferred_from_different_family_names": false,
    "common_ancestry_treated_as_automatic_defect": false,
    "historical_lineage_backfilled_by_guessing": false,
    "qm_a_state_mutated": false,
    "qm_h_findings_closed_by_qm_i": false,
    "scanner_weights_changed": false,
    "decision_layer_semantics_changed": false,
    "portfolio_action_changed": false,
    "orders_generated": false,
    "empirical_promotion_performed": false
  }
}
