{
  "schema_version": "external_evidence_8c_contract_v1",
  "phase": "8C_fundamentals_and_structured_corporate_events",
  "status": "FOUNDATION_ACTIVE_NOT_PROMOTED",
  "baseline": "frozen_phase7_core",
  "sources": [
    "sec_edgar_companyfacts",
    "sec_edgar_submissions_8k_6k"
  ],
  "scope": {
    "fundamentals": true,
    "structured_events": true,
    "outcome_research_enabled": false,
    "decision_integration_enabled": false
  },
  "pit_identity": {
    "filing_key": ["cik", "accession_number"],
    "fact_key": ["cik", "accession_number", "taxonomy", "concept", "unit", "start", "end"],
    "published_at_source": "SEC submissions acceptanceDateTime",
    "valid_from_rule": "published_at when timezone-aware acceptance timestamp exists; otherwise next calendar day after filing_date with DATE_ONLY_DELAYED_VALID_FROM",
    "event_time_may_define_valid_from": false,
    "fiscal_period_end_may_define_valid_from": false,
    "report_date_may_define_valid_from": false,
    "xbrl_fact_without_accession_join_is_pit_safe": false
  },
  "versioning": {
    "preserve_all_accessions": true,
    "amendments_overwrite_prior_records": false,
    "restatements_overwrite_prior_records": false,
    "current_companyfacts_value_retrojection_forbidden": true,
    "revision_id": "accession_number",
    "publication_stages": [
      "CURRENT_REPORT",
      "PERIODIC_REPORT",
      "AMENDMENT",
      "UNKNOWN"
    ]
  },
  "fundamental_families": {
    "revenue": [
      "RevenueFromContractWithCustomerExcludingAssessedTax",
      "Revenues",
      "SalesRevenueNet"
    ],
    "operating_income": ["OperatingIncomeLoss"],
    "net_income": ["NetIncomeLoss", "ProfitLoss"],
    "diluted_eps": ["EarningsPerShareDiluted"],
    "operating_cash_flow": ["NetCashProvidedByUsedInOperatingActivities"],
    "capex": ["PaymentsToAcquirePropertyPlantAndEquipment"],
    "cash": ["CashAndCashEquivalentsAtCarryingValue"],
    "assets": ["Assets"],
    "shareholders_equity": ["StockholdersEquity"],
    "debt": ["LongTermDebt", "LongTermDebtCurrent", "LongTermDebtNoncurrent"]
  },
  "fundamental_change_candidates": [
    "revenue_growth_change",
    "operating_margin_change",
    "free_cash_flow_change",
    "leverage_change",
    "diluted_eps_change"
  ],
  "derived_metric_guards": {
    "same_period_required": true,
    "same_currency_or_unit_required": true,
    "same_publication_vintage_required": true,
    "free_cash_flow_formula": "operating_cash_flow - capex only after concept/unit/context validation",
    "operating_margin_formula": "operating_income / revenue only after concept/unit/context validation",
    "cross_company_tag_fallback_without_validation_forbidden": true,
    "custom_taxonomy_auto_mapping_forbidden": true
  },
  "structured_event_policy": {
    "filing_item_presence_is_direction": false,
    "filing_item_presence_is_trade_signal": false,
    "content_classifier_required_for_directional_event": true,
    "direction_states": ["POSITIVE", "NEGATIVE", "NEUTRAL", "MIXED", "UNKNOWN"],
    "default_direction": "UNKNOWN",
    "foreign_6k_without_item_codes_requires_content_extraction": true
  },
  "target_semantic_events_later": [
    "guidance_raise",
    "guidance_cut",
    "dividend_increase",
    "dividend_decrease",
    "buyback_authorization",
    "buyback_reduction_or_suspension",
    "capital_raise",
    "earnings_beat",
    "earnings_miss",
    "major_contract",
    "acquisition_or_takeover_offer",
    "management_change",
    "production_disruption"
  ],
  "required_record_fields": [
    "source",
    "cik",
    "accession_number",
    "form",
    "filed_date",
    "published_at",
    "ingested_at",
    "valid_from",
    "revision_id",
    "publication_stage",
    "status",
    "reason_codes"
  ],
  "forbidden_shortcuts": [
    "use_period_end_as_publication_time",
    "use_filing_date_intraday_when_acceptance_time_is_unknown",
    "collapse_multiple_accessions_to_latest_value",
    "label_8k_item_as_positive_or_negative_without_content_evidence",
    "infer_guidance_direction_from_item_code_only",
    "infer_earnings_beat_miss_without_point_in_time_expectation_baseline",
    "derive_fcf_or_margin_from_mismatched_contexts",
    "silently_map_custom_xbrl_tags_to_standard_concepts",
    "join_outcomes_before_8c_hypotheses_are_frozen"
  ]
}
