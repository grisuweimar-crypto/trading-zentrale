{
  "schema_version": "external_evidence_8g_prospective_protocol_v1",
  "phase": "8G-G",
  "title": "Prospective post-Holdout shadow confirmation protocol",
  "status": "PRE_REGISTERED_PROSPECTIVE_STREAM_SEALED",
  "research_only": true,
  "productive_integration_enabled": false,
  "automatic_promotion_enabled": false,
  "parent_holdout_protocol": "configs/external_evidence_8g_holdout_protocol_v1.json",
  "active_factor_ids": ["rates_policy", "yield_curve", "fx"],
  "horizons_sessions": [5, 20, 40, 60],
  "frozen_hypothesis_family": [
    "rates_policy_x_5t", "rates_policy_x_20t", "rates_policy_x_40t", "rates_policy_x_60t",
    "yield_curve_x_5t", "yield_curve_x_20t", "yield_curve_x_40t", "yield_curve_x_60t",
    "fx_x_5t", "fx_x_20t", "fx_x_40t", "fx_x_60t"
  ],
  "entry_gates": {
    "8g_f_empirical_completion_required": true,
    "eligible_state_from_8g_f": "HOLDOUT_CONFIRMED",
    "non_confirmed_hypotheses_may_open_prospective_outcomes": false,
    "prospective_rows_must_be_strictly_after_frozen_holdout_cutoff": true,
    "candidate_set_changes_allowed": false,
    "model_refit_allowed": false,
    "feature_change_allowed": false,
    "threshold_change_allowed": false,
    "horizon_reselection_allowed": false,
    "variant_selection_allowed": false,
    "cross_factor_research_allowed": false
  },
  "terminal_evaluation_trigger": {
    "mode": "FIRST_CHRONOLOGICAL_USABLE_COHORT_MEETING_FIXED_EVIDENCE_GATE",
    "minimum_paired_n": 30,
    "minimum_temporal_support_regions": 2,
    "trigger_must_be_outcome_independent": true,
    "repeated_interim_significance_looks_allowed": false,
    "one_terminal_evaluation_per_eligible_hypothesis": true,
    "prospective_rows_after_terminal_trigger_may_reopen_same_test": false
  },
  "prospective_evaluation": {
    "split": "PROSPECTIVE",
    "primary_outcome": "peer_excess_{H}t",
    "primary_metric": "snapshot_aggregated_paired_squared_error_improvement",
    "reuse_frozen_8g_e_metric_and_diagnostics": true,
    "uncertainty": "percentile_circular_moving_block_bootstrap",
    "block_length_sessions": "2 * H",
    "bootstrap_repetitions": 1000,
    "bootstrap_seed": 20260928,
    "confidence_level": 0.95,
    "non_overlap_sensitivity_required": true,
    "regime_domain_diagnostics_required": true,
    "coverage_missingness_required": true,
    "concentration_report_required": true
  },
  "multiple_testing": {
    "method": "Holm",
    "family_wise_alpha": 0.05,
    "family_size": 12,
    "full_frozen_family_retained": true,
    "non_eligible_hypotheses_enter_family_as_p": 1.0,
    "underpowered_eligible_hypotheses_enter_family_as_p": 1.0
  },
  "confirmation_gate": {
    "requires_holdout_confirmed": true,
    "requires_prospective_minimum_evidence": true,
    "requires_prospective_primary_effect_gt_zero": true,
    "requires_prospective_holm_positive": true,
    "requires_prospective_ci_low_gt_zero": true,
    "requires_holdout_prospective_effect_direction_agree": true,
    "requires_non_overlap_not_materially_contradictory": true,
    "requires_pit_integrity_pass": true,
    "requires_coverage_missingness_complete": true,
    "requires_regime_domain_diagnostics_complete_or_explicitly_insufficient": true,
    "failure_authorizes_inverse_signal": false
  },
  "completion_gate": {
    "technical_completion_requires_protocol_tests_and_ci": true,
    "empirical_completion_requires_all_eligible_hypotheses_terminally_evaluated_or_explicitly_insufficient": true,
    "empty_eligible_set_is_valid_empirical_completion": true,
    "next_subphase": "8G-H_PROMOTION_REVIEW"
  },
  "guards": {
    "prospective_outcomes_opened_during_protocol_definition": false,
    "holdout_or_prospective_refit_run": false,
    "prospective_threshold_search_run": false,
    "prospective_feature_search_run": false,
    "prospective_horizon_reselection_run": false,
    "cross_factor_research_enabled": false,
    "phase7_integration_enabled": false,
    "production_external_evidence_enabled": false
  }
}
