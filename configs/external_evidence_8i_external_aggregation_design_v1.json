    "real_component_direction_state_generation_belongs_to": "8I-D_COMPONENT_DIRECTION_STATE_ENGINE_PREREGISTRATION"
  },
  "dependency_graph": {
    "main_effect_is_root_node": true,
    "interaction_is_dependent_child_node": true,
    "interaction_parent_factor_ids_must_match_exact_bound_main_effect_roots": true,
    "connected_components_form_dependency_bundles": true,
    "interaction_may_not_be_counted_as_independent_vote_in_addition_to_parent_bundle": true,
