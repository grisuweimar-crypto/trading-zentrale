    "same_component_may_appear_in_more_than_one_bundle": false,
    "bundle_identity_is_order_invariant": true
  },
  "state_reducer": {
    "method": "SET_SEMANTICS_NO_COUNTS_NO_WEIGHTS",
    "input_direction_states": ["POSITIVE", "NEGATIVE", "UNKNOWN"],
    "output_direction_states": ["POSITIVE", "NEGATIVE", "MIXED", "UNKNOWN", "INSUFFICIENT_EXTERNAL"],
    "rules_in_order": [
      {
        "id": "R1_NO_INCLUDED_EVIDENCE",
        "condition": "no USABLE and no UNKNOWN_VALID component remains after fail-closed exclusions",
        "result": "INSUFFICIENT_EXTERNAL"
      },
      {
        "id": "R2_KNOWN_SIGN_CONFLICT",
        "condition": "the set of known directions contains both POSITIVE and NEGATIVE",
        "result": "MIXED"
      },
      {
        "id": "R3_UNRESOLVED_VALID_EVIDENCE",
        "condition": "UNKNOWN is present and R2 did not apply",
        "result": "UNKNOWN"
      },
      {
        "id": "R4_POSITIVE_ONLY",
        "condition": "the known-direction set equals {POSITIVE} and UNKNOWN is absent",
        "result": "POSITIVE"
      },
      {
        "id": "R5_NEGATIVE_ONLY",
        "condition": "the known-direction set equals {NEGATIVE} and UNKNOWN is absent",
        "result": "NEGATIVE"
      }
    ],
    "multiplicity_changes_result": false,
    "component_order_changes_result": false,
    "majority_vote_allowed": false,
    "numeric_vote_counting_allowed": false,
    "arbitrary_weights_allowed": false,
    "significance_weighting_allowed": false,
    "confidence_weighting_allowed": false,
    "p_value_weighting_allowed": false
  },
  "two_stage_aggregation": {
    "stage_1": "reduce every connected dependency bundle with the frozen set reducer",
    "stage_2": "reduce the set of bundle states with the same reducer",
    "mixed_bundle_contributes_as": ["POSITIVE", "NEGATIVE"],
    "unknown_bundle_contributes_as": ["UNKNOWN"],
    "insufficient_bundle_is_excluded_with_reason": true,
    "bundle_count_or_size_may_change_weight": false,
    "interaction_count_may_change_weight": false
