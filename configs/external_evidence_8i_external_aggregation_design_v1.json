    "interaction_orphan_policy": "FAIL_CLOSED",
    "component_observation_statuses": ["USABLE", "UNKNOWN_VALID", "UNAVAILABLE"],
    "usable_direction_states": ["POSITIVE", "NEGATIVE"],
    "unknown_valid_direction_state": "UNKNOWN",
    "unavailable_component_is_zero_or_neutral": false,
    "unavailable_component_is_excluded_with_reason": true,
    "unknown_valid_component_may_be_excluded": false
