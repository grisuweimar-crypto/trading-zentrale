    "allowed_external_states": ["POSITIVE", "NEGATIVE", "MIXED", "UNKNOWN", "INSUFFICIENT_EXTERNAL"],
    "allowed_relations": ["CONFIRMING", "CONFLICTING", "EXTERNAL_ONLY", "MIXED_EXTERNAL", "UNKNOWN", "INSUFFICIENT_EXTERNAL"],
    "exact_matrix_lookup_required": true,
