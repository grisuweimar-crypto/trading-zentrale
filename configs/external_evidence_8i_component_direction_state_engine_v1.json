    "stance_recompute_in_8i_d_allowed": false,
    "portfolio_action_recompute_in_8i_d_allowed": false
  },
  "direction_adapter": {
    "direction_adapter_id": "incremental_prediction_delta_sign",
    "direction_adapter_version": "v1",
    "direction_adapter_sha256": "d7a3a2ddf519c8df309fea8e0c9404c263945bfa483f7fe57d69e519a813bdcd",
    "semantics": "MODEL_PAIR_INCREMENTAL_PREDICTION_DIRECTION_NOT_CAUSAL_FACTOR_EFFECT",
    "target_template": "peer_excess_{H}t",
    "component_formulas": {
      "8g_main_effect": "challenger_prediction_minus_baseline_prediction",
      "8h_interaction": "challenger_prediction_minus_main_effects_baseline_prediction"
    },
    "strict_state_mapping": [
      {
        "condition": "delta > 0",
        "observation_status": "USABLE",
        "direction_state": "POSITIVE"
      },
      {
        "condition": "delta < 0",
        "observation_status": "USABLE",
        "direction_state": "NEGATIVE"
      },
      {
        "condition": "delta == 0 exactly",
        "observation_status": "UNKNOWN_VALID",
        "direction_state": "UNKNOWN"
      }
    ],
    "zero_deadband": null,
    "round_before_sign": false,
    "absolute_or_relative_threshold": null,
    "semantic_factor_sign_assignment": false,
    "raw_factor_value_sign_used": false,
    "coefficient_sign_used": false,
    "p_value_or_significance_used": false,
    "observed_outcome_used_at_runtime": false
  },
  "semantic_boundary": {
    "positive_means": "The exact frozen challenger model predicts higher peer_excess than its exact paired frozen baseline for the same snapshot, symbol and horizon.",
    "negative_means": "The exact frozen challenger model predicts lower peer_excess than its exact paired frozen baseline for the same snapshot, symbol and horizon.",
    "unknown_zero_means": "The exact frozen model pair produces no incremental prediction displacement for that row.",
    "positive_does_not_mean_raw_macro_value_is_good": true,
    "negative_does_not_mean_raw_macro_value_is_bad": true,
    "direction_is_not_causal_effect": true,
    "direction_is_not_promotion_strength": true,
    "direction_is_not_confidence": true,
    "direction_is_not_trade_signal": true
  },
  "upstream_model_pair_semantics": {
    "8g_main_effect": {
      "baseline": "frozen scanner baseline model",
      "challenger": "same frozen baseline feature family plus exactly one promoted external factor family",
      "shared_feature_coefficients_may_differ_between_separately_fitted_models": true,
      "therefore_delta_is_model_pair_prediction_shift_not_isolated_feature_attribution": true
    },
    "8h_interaction": {
      "baseline": "frozen permitted main-effects model",
      "challenger": "same permitted main effects plus exactly one preregistered interaction",
      "both_underlying_main_effects_remain_present": true,
      "shared_feature_coefficients_may_differ_between_separately_fitted_models": true,
      "therefore_delta_is_model_pair_prediction_shift_not_isolated_interaction_attribution": true
    }
  },
  "input_contract": {
