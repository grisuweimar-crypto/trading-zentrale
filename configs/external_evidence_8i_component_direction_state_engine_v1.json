  "scope": {
    "goal": "Freeze the outcome-blind mapping from an exact promoted frozen model pair's incremental prediction shift to a standardized component direction state for later 8I aggregation.",
    "8i_d_is_preregistration_and_synthetic_engine_only": true,
    "real_bound_component_direction_generation_enabled_now": false,
    "synthetic_contract_execution_allowed": true,
    "aggregation_in_8i_d_allowed": false,
    "relation_to_phase7_in_8i_d_allowed": false,
