  "principles": [
    "scanner observation proves observed presence only",
    "stable identity support and PIT alias support are separate questions",
    "observations before the first conservative alias evidence boundary remain PIT-unverified",
    "crypto base continuity does not define the stable listed object",
    "symbol suffixes are namespace hints and never proof of listing venue",
    "universe-master presence does not prove listing date",
    "universe-master absence does not prove delisting",
    "scanner inclusion or active flags do not prove investability",
    "missing listing, venue, delisting or investability evidence remains UNKNOWN",
    "no strict instrument, alias or membership promotion occurs in this package"
  ],
  "sources": {
