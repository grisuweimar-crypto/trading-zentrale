{
  "schema_version": "qm_research_governance_v1",
  "status": "foundation_only_not_productive",
  "activation_condition": {
    "phase8_must_be_complete": true,
    "branch_must_be_synchronized_with_then_current_main": true,
    "productive_scanner_or_decision_logic_may_change_in_foundation": false
  },
  "purpose": "convert architecture review findings into explicit research-quality controls without rewriting frozen historical evidence or current production semantics",
  "principles": {
    "engineering_completion_is_not_empirical_promotion": true,
    "missing_is_not_neutral": true,
    "spent_evidence_may_not_be_relabelled_unspent": true,
    "preventive_qa_is_distinct_from_outcome_driven_redesign": true,
    "point_in_time_and_available_from_are_mandatory": true,
    "no_retroactive_repair_of_missing_provenance": true,
    "no_super_score_shortcut": true,
    "derived_transformation_does_not_create_independent_evidence_by_default": true,
    "negative_controls_must_not_touch_canonical_artifacts": true
  },
  "workstreams": [
    {
      "id": "QM-A",
      "name": "research_governance_and_evidence_consumption",
      "goal": "bind human and automated research decisions to an auditable spent/unspent protocol"
    },
    {
      "id": "QM-B",
      "name": "as_of_universe_coverage_and_survivorship",
      "goal": "record point_in_time eligibility, inclusion, exclusion and data availability"
    },
    {
      "id": "QM-C",
      "name": "hypothesis_registry_and_global_multiplicity",
      "goal": "register hypothesis families before confirmatory outcome inspection and control family-level multiplicity"
    },
    {
      "id": "QM-D",
      "name": "dependence_effective_n_and_robustness",
      "goal": "report date, symbol, sector and horizon dependence rather than relying on raw event counts"
    },
    {
      "id": "QM-E",
      "name": "probability_calibration_audit",
      "goal": "separate robust directional advantage from actual probability calibration quality"
    },
    {
      "id": "QM-F",
      "name": "decision_layer_incremental_ablation",
      "goal": "measure incremental value of later decision layers without changing frozen Phase7I conclusions"
    },
    {
      "id": "QM-G",
      "name": "elliott_challenger_registry",
      "goal": "register soft Elliott challengers without changing frozen hard rules or structural count semantics"
    },
    {
      "id": "QM-H",
      "name": "defect_near_miss_and_capa_management",
      "goal": "record errors, near misses, inconsistencies and deviations through containment, root-cause analysis, corrective action, prevention and verification"
    },
    {
      "id": "QM-I",
      "name": "evidence_lineage_and_double_counting_audit",
      "goal": "make information ancestry machine-readable and detect hidden reuse of common raw information as apparently independent evidence"
    },
    {
      "id": "QM-J",
      "name": "negative_controls_and_falsification",
      "goal": "challenge the research pipeline with pre-registered controls that should not contain genuine predictive information"
    }
  ],
  "evidence_consumption": {
    "preventive_qa_change": {
      "definition": "change motivated by architecture, code, provenance, contract or methodology review without inspecting future outcome performance for the affected hypothesis",
      "may_preserve_unspent_status": true,
      "log_required": true
    },
    "outcome_driven_research_change": {
      "definition": "change motivated by inspected future outcome performance or downstream realized results",
      "marks_inspected_evidence_spent_for_design": true,
      "log_required": true,
      "spent_evidence_may_not_confirm_redesigned_rule": true
    },
    "required_log_fields": [
      "inspection_id",
      "inspected_at",
      "evidence_version_or_commit",
      "question",
      "outcomes_visible",
      "decision_taken",
      "change_type",
      "spent_for_design",
      "affected_hypothesis_ids",
      "code_or_config_version"
    ]
  },
  "hypothesis_registry": {
    "required": true,
    "required_fields": [
      "hypothesis_id",
      "family_id",
      "description",
      "created_at",
      "freeze_at",
      "status",
      "universe",
      "horizon",
      "target",
      "feature_definition",
      "multiplicity_family",
      "discovery_or_confirmatory",
      "evidence_status",
      "source_or_rationale"
    ],
    "confirmatory_status_requires_pre_outcome_freeze": true,
    "full_family_results_must_be_retained": true,
    "manual_cherry_picking_forbidden": true
  },
  "as_of_universe_ledger": {
    "required": true,
    "required_fields": [
      "as_of",
      "symbol",
      "instrument_id",
      "eligible",
      "inclusion_reason",
      "exclusion_reason",
      "listing_status",
      "exchange",
      "currency",
      "data_provider_coverage",
      "scanner_coverage",
      "price_coverage",
      "sector_or_domain_assignment_id",
      "available_from"
    ],
    "current_membership_may_not_define_historical_membership": true,
    "delistings_and_suspensions_must_remain_observable_when_known": true,
    "missing_target_is_distinct_from_missing_feature": true
  },
  "dependence_and_robustness": {
    "raw_event_count_may_not_be_presented_as_independent_n": true,
    "effective_n_or_dependence_diagnostic_required_for_confirmatory_claims": true,
    "date_concentration_report_required": true,
    "symbol_concentration_report_required": true,
    "sector_or_domain_concentration_report_required_when_available": true,
    "leave_one_sector_or_domain_out_sensitivity_required_when_sample_permits": true,
    "primary_temporal_uncertainty_method_remains_pre_registered": true,
    "alternative_bootstrap_or_block_lengths_are_sensitivity_not_model_selection": true,
    "no_cross_horizon_pooling_without_explicit_estimand": true
  },
  "probability_calibration_audit": {
    "research_only_extension": true,
    "required_diagnostics_when_sample_permits": [
      "reliability_curve",
      "brier_score",
      "log_loss",
      "calibration_intercept",
      "calibration_slope",
      "temporal_calibration_by_epoch"
    ],
    "advantage_probability_is_not_equivalent_to_calibration": true,
    "diagnostics_may_not_rewrite_historical_probability_claims": true
  },
  "decision_layer_ablation": {
    "status": "future_shadow_research_after_phase8",
    "must_not_relabel_phase7i_validation": true,
    "paired_same_claim_comparison_required": true,
    "candidate_ladder": {
      "B0": "position_unchanged_or_no_new_review",
      "B1": "selection_only",
      "B2": "selection_plus_eligible_timing_without_decision_hysteresis",
      "B3": "raw_universal_stance",
      "B4": "universal_stance_plus_hysteresis",
      "B5": "portfolio_action_core_without_elliott_swing_adjustment",
      "B6": "same_portfolio_action_core_with_elliott_swing_adjustment"
    },
    "elliott_incremental_value_primary_pair": ["B5", "B6"],
    "execution_must_remain_disabled_until_separate_promotion": true,
    "b5_b6_lineage_identity_check_required": true,
    "b5_b6_may_differ_only_by_registered_elliott_adjustment": true
  },
  "elliott_challenger_registry": {
    "frozen_hard_rules_may_not_be_rewritten_by_challengers": true,
    "challengers_start_as_soft_sidecar_evidence": true,
    "initial_candidates": [
      "wave_personality_w3_momentum_expansion",
      "wave_personality_w3_volume_expansion",
      "wave_personality_w4_volume_contraction",
      "wave_personality_w4_sideways_character",
      "w5_momentum_divergence",
      "w5_volume_divergence",
      "channel_fit_and_causal_channel_break",
      "alternation_fit",
      "deep_correction_reclaim",
      "scenario_stability",
      "ending_diagonal_reversal"
    ],
    "external_four_signal_challenger_components_are_correlated_price_family_until_proven_otherwise": true,
    "scenario_stability_is_not_assumed_to_equal_correctness": true,
    "w5_divergence_is_not_a_hard_rule": true
  },
  "defect_incident_capa": {
    "required": true,
    "classes": [
      "DEFECT",
      "NEAR_MISS",
      "INCONSISTENCY",
      "DEVIATION",
      "DATA_QUALITY_EVENT",
      "METHODOLOGY_RISK",
      "OBSERVATION"
    ],
    "severity": ["S1_CRITICAL", "S2_MAJOR", "S3_MODERATE", "S4_MINOR"],
    "detection_stage": [
      "DESIGN_REVIEW",
      "CODE_REVIEW",
      "TEST",
      "RESEARCH_RUN",
      "PROSPECTIVE_SHADOW",
      "PRODUCTION"
    ],
    "lifecycle": ["DETECT", "CONTAIN", "ANALYZE", "CORRECT", "PREVENT", "VERIFY", "CLOSE"],
    "required_fields": [
      "incident_id",
      "detected_at",
      "class",
      "severity",
      "detection_stage",
      "affected_phase_or_module",
      "description",
      "potential_or_realized_impact",
      "containment",
      "root_cause",
      "corrective_action",
      "preventive_action",
      "verification_evidence",
      "status",
      "related_commit_or_artifact"
    ],
    "near_misses_must_not_be_discarded_because_no_damage_occurred": true,
    "closure_requires_verification": true,
    "repeat_incidents_require_systemic_root_cause_review": true
  },
  "evidence_lineage": {
    "required": true,
    "representation": "versioned_directed_acyclic_graph",
    "node_types": [
      "raw_feature",
      "derived_metric",
      "research_claim",
      "calibration",
      "risk_context",
      "reliability_annotation",
      "structural_context",
      "external_evidence",
      "decision_usage"
    ],
    "required_node_fields": [
      "node_id",
      "node_type",
      "name",
      "version_or_fingerprint",
      "information_family",
      "available_from_semantics",
      "source_phase_or_module"
    ],
    "required_edge_fields": [
      "from_node_id",
      "to_node_id",
      "transform_id",
      "relationship",
      "directional_role",
      "may_be_counted_as_independent_support"
    ],
    "derived_transformation_is_independent_support_by_default": false,
    "shared_raw_ancestor_requires_double_counting_review": true,
    "shared_raw_ancestor_is_not_automatic_proof_of_invalidity": true,
    "independence_claim_requires_explicit_justification": true,
    "required_audits": [
      "common_raw_ancestor_between_claimed_independent_support",
      "regime_already_embedded_in_selection",
      "risk_already_embedded_in_selection_or_score",
      "selection_reused_inside_confidence_or_agreement",
      "probability_recounted_as_directional_vote",
      "same_family_support_presented_as_cross_family_confirmation",
      "b5_b6_non_elliott_difference"
    ],
    "machine_checkable_path_from_raw_feature_to_decision_usage_required": true
  },
  "negative_controls_and_falsification": {
    "required_for_confirmatory_pipeline_audit": true,
    "research_only_isolated_sandbox": true,
    "canonical_artifacts_may_not_be_mutated": true,
    "control_families": [
      "temporally_shifted_signal",
      "block_preserving_time_permutation",
      "within_date_symbol_permutation",
      "feature_permutation_preserving_missingness",
      "random_pseudo_event",
      "irrelevant_feature_control"
    ],
    "expected_null_behavior_must_be_preregistered": true,
    "negative_controls_are_not_expected_to_equal_exact_zero": true,
    "temporal_and_cross_sectional_structure_should_be_preserved_when_relevant": true,
    "control_failure_requires_leakage_or_pipeline_investigation_before_confirmatory_promotion": true,
    "controls_may_not_be_tuned_until_they_produce_null": true,
    "intentionally_wrong_symbol_mapping_allowed_only_in_isolated_integrity_test": true,
    "wrong_symbol_mapping_is_not_a_statistical_negative_control": true
  },
  "deferred_outside_qm_core": {
    "dynamic_portfolio_correlation": "later_portfolio_risk_overlay",
    "elliott_stage_times_external_evidence": "phase8h_only_after_required_single_family_promotion",
    "fixed_crv_thresholds": "reject_without_empirical_comparison",
    "fixed_position_sizing_rules": "outside_current_qm_scope"
  },
  "forbidden_shortcuts": [
    "retrofit_missing_historical_provenance",
    "reuse_outcome_inspected_evidence_as_unspent_confirmation",
    "select_confirmatory_hypotheses_after_viewing_confirmatory_outcomes",
    "treat_raw_event_count_as_independent_sample_size",
    "use_current_universe_as_historical_universe",
    "choose_bootstrap_or_block_length_by_best_result",
    "treat_probability_advantage_as_calibration_proof",
    "let_elliott_soft_challengers_rewrite_frozen_structural_counts_before_validation",
    "promote_b6_from_unpaired_or_retrospective_comparison",
    "count_transforms_of_common_information_as_independent_votes_without_review",
    "hide_failed_negative_controls",
    "tune_negative_controls_until_the_pipeline_passes"
  ]
}
