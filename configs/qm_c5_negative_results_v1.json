{
  "schema_version": "qm_c5_negative_results_v1",
  "module": "QM-C5",
  "name": "Negative / Rejected Results Registry",
  "status": "active_research_governance",
  "research_only": true,
  "productive_integration_enabled": false,
  "execution_allowed": false,
  "purpose": "Retain positive, negative, inconclusive and pre-evaluation rejected/retired outcomes symmetrically so result visibility cannot depend on whether the finding is attractive.",
  "principles": {
    "negative_results_are_retained": true,
    "rejected_hypotheses_are_retained": true,
    "positive_results_do_not_receive_special_retention": true,
    "result_versions_are_immutable": true,
    "confirmatory_results_require_exact_c1_c2_c3_c4_qm_a_binding": true,
    "confirmatory_results_require_consumed_evidence": true,
    "missing_is_not_neutral": true,
    "technical_completion_is_not_empirical_promotion": true
  },
  "registry": {
    "event_schema_version": "qm_c5_result_event_v1",
    "hash_chain_required": true,
    "default_path": "artifacts/research/qm/qm_c5_results.jsonl",
    "event_types": ["RESULT_REGISTERED"]
  },
  "result_record": {
    "required_fields": [
      "result_id", "result_version", "hypothesis_id", "hypothesis_version", "hypothesis_version_hash",
      "evidence_scope", "outcome_classification", "conclusion", "evidence_artifact_hash",
      "analysis_plan_id", "analysis_plan_version", "analysis_plan_hash",
      "control_plan_id", "control_plan_version", "control_plan_hash",
      "monitoring_plan_id", "monitoring_plan_version", "monitoring_plan_hash",
      "qm_a_analysis_id", "qm_a_version_id"
    ],
    "evidence_scopes": ["NO_OUTCOME_EVIDENCE", "EXPLORATORY", "CONFIRMATORY"],
    "outcome_classifications": ["POSITIVE", "NEGATIVE", "INCONCLUSIVE", "REJECTED_PRE_EVALUATION", "RETIRED_WITHOUT_EVALUATION"],
    "evaluated_classifications": ["POSITIVE", "NEGATIVE", "INCONCLUSIVE"],
    "no_outcome_classifications": ["REJECTED_PRE_EVALUATION", "RETIRED_WITHOUT_EVALUATION"]
  },
  "bindings": {
    "qm_c1_contract_schema": "qm_c_hypothesis_registry_v1",
    "qm_c2_contract_schema": "qm_c_analysis_plan_v1",
    "qm_c3_contract_schema": "qm_c3_families_multiplicity_v1",
    "qm_c4_contract_schema": "qm_c4_sequential_monitoring_v1",
    "qm_a_contract_schema": "qm_a_research_governance_v1"
  },
  "boundaries": {
    "closure_or_handoff_implemented_here": false,
    "fuzzy_duplicate_merging_performed": false,
    "historical_results_invented": false,
    "scanner_or_decision_semantics_changed": false,
    "portfolio_action_or_order_generation_allowed": false,
    "empirical_promotion_performed": false
  }
}
