{
  "schema_version": "external_evidence_8g_evaluation_protocol_v1",
  "phase": "8G-E",
  "title": "Confirmatory incremental-value evaluation protocol",
  "status": "PRE_REGISTERED_WAITING_FOR_FROZEN_DISCOVERY_MODELS",
  "research_only": true,
  "productive_integration_enabled": false,
  "automatic_promotion_enabled": false,
  "parent_8g_a_contract": "configs/external_evidence_8g_research_contract_v1.json",
  "parent_8g_d_protocol": "configs/external_evidence_8g_discovery_protocol_v1.json",
  "parent_8g_d_technical_head": "7ebde5bbda512c3d9ebc2ce6e127e0c4305551cb",
  "active_factor_ids": ["rates_policy", "yield_curve", "fx"],
  "horizons_sessions": [5, 20, 40, 60],
  "frozen_hypothesis_family": [
    "rates_policy_x_5t", "rates_policy_x_20t", "rates_policy_x_40t", "rates_policy_x_60t",
    "yield_curve_x_5t", "yield_curve_x_20t", "yield_curve_x_40t", "yield_curve_x_60t",
    "fx_x_5t", "fx_x_20t", "fx_x_40t", "fx_x_60t"
  ],
  "entry_gates": {
    "final_discovery_freeze_receipt_required": true,
    "discovery_fit_hash_must_match_receipt": true,
    "preprocessor_hash_must_match_receipt": true,
    "validation_opens_before_holdout": true,
    "holdout_requires_frozen_full_validation_family": true,
    "holdout_open_once": true,
    "validation_refit_allowed": false,
    "holdout_refit_allowed": false,
    "model_or_feature_change_after_discovery_freeze_allowed": false
  },
  "primary_metric": {
    "outcome": "peer_excess_{H}t",
    "baseline_loss": "squared_error",
    "challenger_loss": "squared_error",
    "paired_row_improvement": "baseline_squared_error_minus_challenger_squared_error",
    "positive_value_means": "challenger_improves_prediction",
    "snapshot_aggregation": "mean_paired_row_improvement_within_snapshot",
    "split_estimand": "mean_snapshot_level_paired_improvement",
    "point_estimate_rows_may_overlap": true
  },
  "uncertainty": {
    "method": "percentile_circular_moving_block_bootstrap",
    "bootstrap_repetitions": 1000,
    "bootstrap_seed": 20260928,
    "confidence_level": 0.95,
    "block_index": "start_market_date",
    "block_length_sessions": "2 * H",
    "two_sided_null_p_value": "centered_circular_moving_block_bootstrap_abs_mean",
    "iid_row_bootstrap_allowed": false
  },
  "minimum_evidence": {
    "minimum_paired_n_per_factor_horizon_split": 30,
    "minimum_temporal_support_regions": 2,
    "threshold_relaxation_allowed": false,
    "underpowered_state": "INSUFFICIENT_EVIDENCE"
  },
  "multiple_testing": {
    "method": "Holm",
    "family_wise_alpha": 0.05,
    "family_size": 12,
    "family_membership_frozen": true,
    "underpowered_or_missing_primary_p_value": 1.0,
    "two_sided_p_values": true,
    "positive_confirmatory_result_requires": [
      "primary_effect_gt_zero",
      "holm_adjusted_p_lt_0_05"
    ]
  },
  "split_policy": {
    "validation": {
      "outcomes_open_only_after_final_discovery_freeze": true,
      "all_12_hypotheses_must_be_frozen_before_family_result": true,
      "may_change_model_or_evaluation_spec": false
    },
    "holdout": {
      "outcomes_open_only_after_validation_family_freeze": true,
      "open_once": true,
      "may_change_model_or_evaluation_spec": false,
      "promotion_requires_positive_95pct_ci": true
    }
  },
  "non_overlap_sensitivity": {
    "required": true,
    "selection_rule": "chronological greedy selection by start_market_date; next retained snapshot must start after the previous retained snapshot label_available_from_{H}t",
    "uses_outcome_value_for_selection": false,
    "material_contradiction_rule": "if primary_effect_gt_zero and at_least_2_nonoverlap_snapshots and nonoverlap_mean_improvement_lte_zero then CONTRADICTS_PRIMARY"
  },
  "stability_diagnostics": {
    "regime_field": "market_regime_stock",
    "domain_fields": ["sector", "currency"],
    "context_join_identity": ["snapshot_id", "as_of", "symbol"],
    "context_must_be_point_in_time": true,
    "context_missing_state": "DIAGNOSTIC_CONTEXT_INCOMPLETE",
    "minimum_group_paired_n_for_direction_report": 10,
    "regime_and_domain_results_are_diagnostics_not_independent_promotion_triggers": true
  },
  "coverage_missingness": {
    "required": true,
    "paired_row_coverage_denominator": "all baseline rows in the exact factor/snapshot evaluation universe before mapping exclusion",
    "external_feature_missingness_must_be_reported": true,
    "unmapped_rows_must_be_reported": true,
    "ambiguous_mapping_rows_must_be_reported": true,
    "coverage_threshold_selected_from_outcomes_allowed": false
  },
  "concentration": {
    "required": true,
    "groupings": ["start_market_date", "symbol", "sector"],
    "metric": "max_absolute_group_contribution_divided_by_sum_absolute_group_contributions",
    "outcome_derived_exclusion_allowed": false
  },
  "secondary_diagnostics": {
    "mean_absolute_error_improvement": true,
    "prediction_spearman_baseline": true,
    "prediction_spearman_challenger": true,
    "adverse_excursion_description": true,
    "path_max_drawdown_description": true,
    "secondary_outcomes_are_independent_promotion_triggers": false
  },
  "cost_turnover": {
    "status": "NOT_APPLICABLE_WHILE_8G_REMAINS_PREDICTIVE_RESEARCH_ONLY",
    "reason": "8G creates no trade, order, sizing or action policy. Turnover/trading-cost evaluation becomes mandatory only if a later 8I decision policy makes external evidence action-relevant."
  },
  "promotion_candidate_gate": {
    "unit": "factor_horizon_challenger",
    "automatic_promotion": false,
    "requires_validation": [
      "minimum_evidence_met",
      "primary_effect_gt_zero",
      "holm_adjusted_p_lt_0_05"
    ],
    "requires_holdout": [
      "minimum_evidence_met",
      "primary_effect_gt_zero",
      "holm_adjusted_p_lt_0_05",
      "primary_95pct_ci_low_gt_zero",
      "non_overlap_sensitivity_not_materially_contradictory",
      "validation_and_holdout_effect_direction_agree",
      "PIT_integrity_pass",
      "coverage_missingness_report_complete",
      "regime_domain_diagnostics_complete_or_explicitly_insufficient"
    ],
    "candidate_state": "PROMOTION_CANDIDATE_FOR_8H_REVIEW",
    "adequately_sampled_not_confirmed_state": "NO_PROMOTION_EVIDENCE",
    "underpowered_state": "INSUFFICIENT_EVIDENCE",
    "rejection_authorizes_inverse_signal": false
  },
  "guards": {
    "validation_outcomes_opened_during_protocol_definition": false,
    "holdout_outcomes_opened_during_protocol_definition": false,
    "model_refit_on_validation": false,
    "model_refit_on_holdout": false,
    "post_hoc_threshold_search": false,
    "post_hoc_feature_search": false,
    "cross_factor_research_enabled": false,
    "phase7_integration_enabled": false,
    "production_external_evidence_enabled": false
  },
  "next_phase_after_8g_e": "8G-F_FINAL_SINGLE_FACTOR_PROMOTION_FREEZE"
}
